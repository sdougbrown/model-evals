+  test('validator that returns false as boolean sets error from fallback', async () => {
+    const ump = umpire({
+      fields: { x: {} },
+      rules: [],
+      validators: {
+        x: {
+          validator: (v: string) => v.length > 0,
+          error: 'Fallback error',
+        },
