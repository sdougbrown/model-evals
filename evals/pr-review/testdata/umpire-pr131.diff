+    expect(r.x.valid).toBe(false)
+    expect(r.x.error).toBe('Fallback error')
+  })
+
+  test('ignores undefined validator entries', async () => {
+    const ump = umpire({
+      fields: { a: {}, b: {} },
+      rules: [],
+      validators: {
+        a: undefined,
+        b: (v: string) => v.length > 0,
+      },
