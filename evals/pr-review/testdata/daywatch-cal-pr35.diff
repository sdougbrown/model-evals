+// Feed URLs often embed auth tokens (incident.io puts one in the path), so
+// anything echoed back to the caller hides long path segments and the query.
+function redactFeedUrl(raw: string): string {
+  let url: URL;
+  try {
+    url = new URL(raw);
+  } catch {
+    return '<invalid url>';
+  }
