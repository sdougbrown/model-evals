+type reviewNavigationEntry struct {
+	ID          int64
+	State       string
+	HTMLURL     string
+	SubmittedAt time.Time
+}
+
+func buildReviewBodyWithNavigation(ctx context.Context, client *github.Client, j *job.ReviewJob, botLogin string, currentReviewID int64, currentReviewURL, currentState, announcement, summary string) (string, error) {
+	entries, err := listBotReviewNavigationEntries(ctx, client, j, botLogin)
+	if err != nil {
+		return "", err
+	}
+	entries = mergeCurrentReviewNavigationEntry(entries, reviewNavigationEntry{
+		ID:      currentReviewID,
+		State:   currentState,
+		HTMLURL: currentReviewURL,
+	})
+	if len(entries) == 0 {
+		return announcement + summary, nil
+	}
+	return announcement + formatReviewNavigation(entries, currentReviewID) + "\n\n" + summary, nil
+}
+
+func listBotReviewNavigationEntries(ctx context.Context, client *github.Client, j *job.ReviewJob, botLogin string) ([]reviewNavigationEntry, error) {
+	var entries []reviewNavigationEntry
+	opts := &github.ListOptions{PerPage: 100}
+	for {
+		var reviews []*github.PullRequestReview
+		resp, err := gh.WithGitHubRetry(ctx, "list review navigation", func() (*github.Response, error) {
+			var callResp *github.Response
+			var callErr error
+			reviews, callResp, callErr = client.PullRequests.ListReviews(ctx, j.RepoOwner, j.RepoName, j.PRNumber, opts)
+			return callResp, callErr
+		})
+		if err != nil {
+			return nil, err
+		}
+		for _, r := range reviews {
+			if r == nil || r.User == nil || r.User.GetLogin() != botLogin {
+				continue
+			}
+			entries = append(entries, reviewNavigationEntry{
+				ID:          r.GetID(),
+				State:       r.GetState(),
+				HTMLURL:     r.GetHTMLURL(),
+				SubmittedAt: r.GetSubmittedAt().Time,
+			})
+		}
+		if resp == nil || resp.NextPage == 0 {
+			break
+		}
+		opts.Page = resp.NextPage
+	}
+	sort.SliceStable(entries, func(i, k int) bool {
+		if entries[i].SubmittedAt.Equal(entries[k].SubmittedAt) {
+			return entries[i].ID < entries[k].ID
+		}
+		return entries[i].SubmittedAt.Before(entries[k].SubmittedAt)
+	})
+	return entries, nil
+}
+
+func mergeCurrentReviewNavigationEntry(entries []reviewNavigationEntry, current reviewNavigationEntry) []reviewNavigationEntry {
+	if current.ID == 0 {
+		return entries
+	}
+	for i := range entries {
+		if entries[i].ID != current.ID {
+			continue
+		}
+		if current.State != "" {
+			entries[i].State = current.State
+		}
+		if current.HTMLURL != "" {
+			entries[i].HTMLURL = current.HTMLURL
+		}
+		return entries
+	}
+	return append(entries, current)
+}
+
+func formatReviewNavigation(entries []reviewNavigationEntry, currentReviewID int64) string {
+	var b strings.Builder
+	fmt.Fprintf(&b, "#### Play by play: %d bot review", len(entries))
+	if len(entries) != 1 {
+		b.WriteString("s")
+	}
+	b.WriteString("\n\n")
+	for i, entry := range entries {
+		label := humanReviewState(entry.State)
+		if entry.HTMLURL != "" {
+			fmt.Fprintf(&b, "%d. [Review %d: %s](%s)", i+1, i+1, label, entry.HTMLURL)
+		} else {
+			fmt.Fprintf(&b, "%d. Review %d: %s", i+1, i+1, label)
+		}
+		if entry.ID == currentReviewID {
+			b.WriteString(" 👈")
+		}
+		b.WriteString("\n")
+	}
+	return strings.TrimRight(b.String(), "\n")
+}
+
+func humanReviewState(state string) string {
+	trimmed := strings.TrimSpace(state)
+	switch strings.ToUpper(trimmed) {
+	case "COMMENT", "COMMENTED":
+		return "Comment"
+	case "REQUEST_CHANGES", "CHANGES_REQUESTED":
+		return "Request changes"
+	case "APPROVE", "APPROVED":
+		return "Approve"
+	case "DISMISSED":
+		return "Dismissed"
+	default:
+		if trimmed == "" {
+			return "Unknown"
+		}
+		return strings.ReplaceAll(strings.ToLower(trimmed), "_", " ")
+	}
+}
